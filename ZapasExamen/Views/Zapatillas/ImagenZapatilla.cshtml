@model ImagenZapatilla
@{
    int anterior = (int)ViewData["ANTERIOR"];
    int siguiente = (int)ViewData["SIGUIENTE"];
    int ultimo = (int)ViewData["ULTIMO"];

    int numRegistros = 0;
    int posicion = 1;
    int idproducto = 0;
    if(ViewData["NUMREGISTROS"] != null)
    {
        numRegistros = (int)ViewData["NUMREGISTROS"];
        posicion = (int)ViewData["POSICION"];
        idproducto = (int)ViewData["IDPRODUCTO"];
    }
    @if(Model != null)
    {
       <h3>Imagen @posicion de @numRegistros</h3>
       <ul>
       <li>
        <button accesskey="p">
          Primero
          </button>
       </li>
       <li>
       <button accesskey="a">
       Anterior
       </button>
       </li>
       <li>
       <button accesskey="s">
       Siguiente
       </button>
       </li>
       <li>
       <button accesskey="u">
       Último
       </button>
       </li>
       </ul>
    }