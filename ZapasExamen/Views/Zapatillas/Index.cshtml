@model Zapatilla

@if(Model != null)
{
    <ul>
                <li>
            <strong>Marca:</strong> @Model.Nombre
        </li>
        <li>
            <strong>Modelo:</strong> @Model.Descripcion
        </li>
        <li>
            <strong>Precio:</strong> @Model.Precio
        </li>
    </ul>
}
<p>
    <a asp-action="Index" asp-controller="Zapatillas">Volver al listado de zapatillas</a>
</p>
<div id="containerImagenes"></div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $.ajax({
                url: '@Url.Action("ImagenZapatilla", "Zapatillas")',
                data: { id: @Model.IdProducto },
                success: function (data) {
                    $('#containerImagenes').html(data);
                }
            });
        });
    </script>
}