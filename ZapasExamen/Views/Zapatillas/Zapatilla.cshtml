@model List<Zapatilla>
@{
    ViewData["Title"] = "Listado de Zapatillas";
}

<h1>Listado de Zapatillas</h1>
<table class="table">
    <thead>
        <tr>
            <th>Zapatillas</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
               <td><a asp-action="Detalles" asp-route-idproducto="@item.IdProducto">@item.Nombre</a></td>
            </tr>
        }
    </tbody>
</table>